# Copy to .env.production (gitignored) and fill in before first deploy.
#   cp .env.production.example .env.production

# GCP
GCP_PROJECT=foxtware
GCP_REGION=australia-southeast1

# Supabase Postgres — use the transaction-mode pooler (IPv4) for Cloud Run.
# DATABASE_URL = app role (no BYPASSRLS). DATABASE_OWNER_URL = owner role (migrations).
DATABASE_URL=postgres://APP_USER:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_OWNER_URL=postgres://OWNER_USER:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Long random string; generate once and keep stable across deploys.
#   openssl rand -hex 32
SESSION_HMAC_SECRET=

# Leave empty (or "auto") to use the Cloud Run URL after first deploy.
# Set to your custom domain origin once you map one, e.g. https://smorg.app
APP_ORIGIN=auto

# Gmail SMTP (OTP login codes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smorgapps@gmail.com
SMTP_PASS=
SMTP_FROM=smorgapps@gmail.com
